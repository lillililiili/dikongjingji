# Production mobile builds must use the public HTTPS gateway.
VITE_INSPECTION_API_BASE_URL=https://api.example.com
# Acceptance builds may opt into private-LAN discovery together with the existing
# insecure-LAN gate. Public HTTPS builds must leave this disabled.
VITE_INSPECTION_ENABLE_LAN_DISCOVERY=false
# Used only when the host App has not restored its shared current-city context.
VITE_INSPECTION_DEFAULT_CITY_CODE=370500
VITE_INSPECTION_DEFAULT_CITY_NAME=东营市
# Enables platform preview channels in acceptance builds; keep false for public production builds.
VITE_PLATFORM_PREVIEW_ENABLED=false
# Release switches of public builds (docs/ops/发布开关.md). The committed defaults live in
# src/app-shell/release/release-features.json; a one-off build may override one with true or false:
# VITE_FEATURE_MALL=true
