# Copy this file to .env and replace every REPLACE_WITH value before starting Compose.
# Keep .env local; it is intentionally ignored by Git.
INSPECTION_ENVIRONMENT=dev
# Default for a lasting workspace. Enable fixtures only in a separate demo database.
PLATFORM_DEMO_DATA_ENABLED=false
PLATFORM_DEMO_DATA_REFRESH_AT_MIDNIGHT=false
# First operator on a new workspace. Provide both values locally for the first start.
PLATFORM_BOOTSTRAP_OPERATOR_LOGIN=
PLATFORM_BOOTSTRAP_OPERATOR_PASSWORD=
INSPECTION_DB_NAME=inspection
INSPECTION_DB_USERNAME=REPLACE_WITH_LOCAL_DB_USERNAME
INSPECTION_DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

# Redis is intentionally unauthenticated only inside the private local Compose network.
INSPECTION_REDIS_PASSWORD=

INSPECTION_MINIO_ACCESS_KEY=REPLACE_WITH_LOCAL_MINIO_ACCESS_KEY
INSPECTION_MINIO_SECRET_KEY=REPLACE_WITH_LOCAL_MINIO_SECRET_KEY
# Local browser/device reachable endpoint used only to sign short-lived URLs.
# Production must use the externally reachable HTTPS MinIO or object-gateway URL.
INSPECTION_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
INSPECTION_RESERVATION_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
INSPECTION_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173

# Replace with Base64 encoding of at least 32 random bytes. This invalid placeholder is not a secret.
INSPECTION_JWT_HMAC_BASE64_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
# Replace with Base64 encoding of exactly 32 random bytes. Do not reuse the JWT key.
INSPECTION_DATA_ENCRYPTION_BASE64_KEY=REPLACE_WITH_BASE64_OF_EXACTLY_32_RANDOM_BYTES

# Optional real weather adapter. Keep disabled unless a server-side AMap
# Web Service key is configured; never copy this key into the mobile app.
PLATFORM_WEATHER_ENABLED=false
PLATFORM_WEATHER_API_KEY=

# Inspection plans snapshot payment nodes only when this is true. Keep it false
# until the unified trade module can collect them.
INSPECTION_PAYMENT_NODES_ENABLED=false

# All host bindings default to loopback. Backend and MinIO may be changed to 0.0.0.0 only for temporary LAN acceptance; PostgreSQL and Redis must remain loopback.
INSPECTION_APP_BIND_ADDRESS=127.0.0.1
INSPECTION_BACKEND_BIND_ADDRESS=127.0.0.1
INSPECTION_MINIO_BIND_ADDRESS=127.0.0.1
INSPECTION_APP_PORT=8080
INSPECTION_POSTGRES_PORT=5432
INSPECTION_REDIS_PORT=6379
INSPECTION_MINIO_API_PORT=9000
INSPECTION_MINIO_CONSOLE_PORT=9001
