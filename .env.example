# Copy this file to .env and replace every REPLACE_WITH value before starting Compose.
# Keep .env local; it is intentionally ignored by Git.
INSPECTION_ENVIRONMENT=dev
INSPECTION_DB_NAME=inspection
INSPECTION_DB_USERNAME=REPLACE_WITH_LOCAL_DB_USERNAME
INSPECTION_DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

# Redis is intentionally unauthenticated only inside the private local Compose network.
INSPECTION_REDIS_PASSWORD=

INSPECTION_MINIO_ACCESS_KEY=REPLACE_WITH_LOCAL_MINIO_ACCESS_KEY
INSPECTION_MINIO_SECRET_KEY=REPLACE_WITH_LOCAL_MINIO_SECRET_KEY

# Replace with Base64 encoding of at least 32 random bytes. This invalid placeholder is not a secret.
INSPECTION_JWT_HMAC_BASE64_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES

# All host bindings default to loopback and may be changed for local debugging only.
INSPECTION_APP_BIND_ADDRESS=127.0.0.1
INSPECTION_APP_PORT=8080
INSPECTION_POSTGRES_PORT=5432
INSPECTION_REDIS_PORT=6379
INSPECTION_MINIO_API_PORT=9000
INSPECTION_MINIO_CONSOLE_PORT=9001
