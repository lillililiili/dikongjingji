# 生产反向代理（S2-4，docs/ops/部署与回滚.md）。nginx 镜像启动时用环境变量替换 ${LA_*}，
# nginx 自己的 $ 变量不在环境里，原样保留。
#
#   ${LA_API_DOMAIN}    后端接口，App 和 H5 都调它；微信支付回调也走这里
#   ${LA_H5_DOMAIN}     H5 静态站点
#   ${LA_ADMIN_DOMAIN}  运营端与商家工作台，允许留空
#   ${LA_FILES_DOMAIN}  对象存储：预签名的上传下载地址，和 public-assets 桶里已授权的展示图

server_tokens off;
client_max_body_size 2m;

# 证书覆盖已启用的域名。
ssl_certificate     /etc/nginx/tls/fullchain.pem;
ssl_certificate_key /etc/nginx/tls/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $uri $admin_cache_control {
    default "";
    /index.html "no-cache";
    ~^/assets/ "public, max-age=2592000, immutable";
}

# 80：只做证书验证和跳转。容器健康检查也打这里。
server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /srv/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 不认识的域名一律断开，不暴露默认站点。
server {
    listen 443 ssl default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LA_API_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # 对外的健康检查只给状态（后端 show-details: never）。
    location = /healthz {
        proxy_pass http://backend:8080/actuator/health;
        access_log off;
    }

    # 其余 actuator 不对外。
    location /actuator/ {
        return 404;
    }

    # App 售后凭证允许上传 5 MiB 的图片，预留 multipart 表单边界空间。
    location = /api/v1/trade/aftersale-images {
        client_max_body_size 6m;
        include /etc/nginx/templates/api-proxy.inc;
    }

    location /api/ {
        include /etc/nginx/templates/api-proxy.inc;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LA_H5_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    root /srv/web/current;
    index index.html;

    # 带内容哈希的资源长缓存；index.html 不缓存，发布和回滚立刻生效。
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # uni-app H5 用 hash 路由，其余路径都回首页。
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name "${LA_ADMIN_DOMAIN}";
    # 域名留空时只有无 Host 的请求可能命中这个虚拟主机。
    if ($http_host = "") { return 444; }

    root /srv/admin/current;
    index index.html;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control $admin_cache_control;

    location /api/ {
        # 与后端 multipart 请求上限相同，允许上传运营素材与资质附件。
        client_max_body_size 51m;
        include /etc/nginx/templates/api-proxy.inc;
    }
    location /assets/ { try_files $uri =404; }
    location = /index.html { try_files $uri =503; }
    location / { try_files $uri $uri/ /index.html; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LA_FILES_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # 预签名上传（预约附件）走这里，上限比后端校验的稍大。
    client_max_body_size 50m;

    location /minio/ {
        return 404;
    }

    location / {
        proxy_pass http://minio:9000;
        proxy_http_version 1.1;
        # 预签名按这个域名算，Host 原样转发，否则签名对不上。
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
