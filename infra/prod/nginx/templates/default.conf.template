# 生产反向代理（S2-4，docs/ops/部署与回滚.md）。nginx 镜像启动时用环境变量替换 ${LA_*}，
# nginx 自己的 $ 变量不在环境里，原样保留。
#
#   ${LA_API_DOMAIN}    后端接口，App 和 H5 都调它；微信支付回调也走这里
#   ${LA_H5_DOMAIN}     H5 静态站点
#   ${LA_FILES_DOMAIN}  对象存储：预签名的上传下载地址，和 public-assets 桶里已授权的展示图

server_tokens off;
client_max_body_size 2m;

# 证书一张覆盖三个域名。
ssl_certificate     /etc/nginx/tls/fullchain.pem;
ssl_certificate_key /etc/nginx/tls/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 80：只做证书验证和跳转。容器健康检查也打这里。
server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /srv/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 不认识的域名一律断开，不暴露默认站点。
server {
    listen 443 ssl default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LA_API_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # 对外的健康检查只给状态（后端 show-details: never）。
    location = /healthz {
        proxy_pass http://backend:8080/actuator/health;
        access_log off;
    }

    # 其余 actuator 不对外。
    location /actuator/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 只传真实的客户端地址，不接客户端自带的 X-Forwarded-For（限流按它算）。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LA_H5_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    root /srv/web/current;
    index index.html;

    # 带内容哈希的资源长缓存；index.html 不缓存，发布和回滚立刻生效。
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # uni-app H5 用 hash 路由，其余路径都回首页。
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LA_FILES_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # 预签名上传（预约附件）走这里，上限比后端校验的稍大。
    client_max_body_size 50m;

    location /minio/ {
        return 404;
    }

    location / {
        proxy_pass http://minio:9000;
        proxy_http_version 1.1;
        # 预签名按这个域名算，Host 原样转发，否则签名对不上。
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
