# 生产环境变量（S2-4）。复制到服务器的 /etc/low-altitude/prod.env，权限 600，属主 root；逐项填值。
# 这个文件只写变量名和说明，不写真实值；填好的文件不进仓库、不发聊天。
# 同一个文件两用：docker compose --env-file 用它替换 docker-compose.yml 里的 ${...}，后端容器也用 env_file 整个读进去。
# 生成随机值：openssl rand -base64 32（密码类可以用 openssl rand -hex 24）。

# ---- 部署 ----
# 环境名：小写字母、数字和 -，进对象存储桶名（<环境名>-inspection-private 等）。不能用 dev、test、local。
LA_ENVIRONMENT=
# 后端镜像标签：发布时用提交号（git rev-parse --short HEAD），回滚时改回上一个。
LA_BACKEND_TAG=
# 这个文件自己的路径（后端容器的 env_file），默认 /etc/low-altitude/prod.env。
LA_ENV_FILE=
# 数据目录（postgres、redis、minio 三个子目录），例如 /srv/low-altitude/data。
LA_DATA_DIR=
# 备份目录（db 子目录），例如 /srv/low-altitude/backups；最好是另一块盘。
LA_BACKUP_DIR=
# 备份保留天数，默认 14。
LA_BACKUP_KEEP_DAYS=
# 可选：把备份拷到异地的命令，脚本以文件路径为参数调用，例如对象存储命令行的上传命令。
LA_BACKUP_OFFSITE_CMD=
# HTTPS 证书目录（fullchain.pem、privkey.pem），默认 /etc/low-altitude/tls。
LA_TLS_DIR=
# H5 站点目录（releases/、current 链接），默认 /srv/low-altitude/web。
LA_WEB_DIR=
# 证书 HTTP-01 验证目录，默认 /srv/low-altitude/acme。
LA_ACME_DIR=
# 密钥目录（wechat/ 子目录放两个 PEM），默认 /etc/low-altitude/secrets。
LA_SECRETS_DIR=
# 后端 JVM 参数，默认 -XX:MaxRAMPercentage=75。
LA_BACKEND_JAVA_OPTS=

# ---- 域名（只写域名，不带 https://）----
# 后端接口域名，App 的 VITE_INSPECTION_API_BASE_URL 是 https://<它>。
LA_API_DOMAIN=
# H5 站点域名（也是后端允许的跨域来源）。
LA_H5_DOMAIN=
# 对象存储域名：预签名上传下载、已授权展示图。
LA_FILES_DOMAIN=

# ---- 数据库、Redis、对象存储 ----
LA_DB_NAME=
LA_DB_USERNAME=
LA_DB_PASSWORD=
LA_REDIS_PASSWORD=
# MinIO 管理账号（也是后端访问对象存储用的账号）。至少 8 位 / 16 位以上随机串。
LA_MINIO_ACCESS_KEY=
LA_MINIO_SECRET_KEY=

# ---- 后端密钥与业务配置（后端直接读这些名字）----
# 登录令牌签名密钥：至少 32 个随机字节的 Base64。
INSPECTION_JWT_HMAC_BASE64_SECRET=
# 敏感资料（联系人、地址）加密密钥：正好 32 个随机字节的 Base64；不要和上面的相同。丢了已加密的资料读不出来，单独备份。
INSPECTION_DATA_ENCRYPTION_BASE64_KEY=
# 预约附件允许的类型，例如 image/jpeg,image/png,application/pdf。
INSPECTION_RESERVATION_ALLOWED_MIME_TYPES=
# 巡检付款节点：S4-1 做好前保持 false。
INSPECTION_PAYMENT_NODES_ENABLED=false
# 天气（服务端高德 Web 服务 Key）：没有 Key 就保持 false。
PLATFORM_WEATHER_ENABLED=false
PLATFORM_WEATHER_API_KEY=
# 直播服务商：D20 定之前保持 none（直播间建不了，回调全部拒绝）。
LIVE_STREAM_PROVIDER=none
# 平台文件存储（运营素材、商品图片、导入文件、资质附件、服务订单交付文件、售后凭证）：s3 = 接上面的 MinIO，
# 地址、账号、桶名由 docker-compose.yml 按 LA_* 填好；local = 这六类在生产上传下载都回 503。
# 换云对象存储时在这里覆盖 PLATFORM_STORAGE_S3_*（docs/ops/部署与回滚.md §3.2）。
PLATFORM_STORAGE_PROVIDER=s3

# ---- 首个平台运营账号（一次性，docs/ops/部署与回滚.md §3.1）----
# 只在第一次部署时填；建好后删掉这两行和口令文件，再 up -d backend。口令放文件里，不直接写在这里。
PLATFORM_BOOTSTRAP_OPERATOR_LOGIN=
PLATFORM_BOOTSTRAP_OPERATOR_PASSWORD_FILE=

# ---- 微信支付（docs/ops/微信支付联调清单.md）----
# 联调通过前保持 false；关着时发起支付回“渠道不可用”。
TRADE_WECHAT_ENABLED=false
TRADE_WECHAT_SP_MCHID=
TRADE_WECHAT_SP_APPID=
TRADE_WECHAT_MERCHANT_SERIAL_NO=
TRADE_WECHAT_MERCHANT_PRIVATE_KEY_PATH=/etc/low-altitude/secrets/wechat/apiclient_key.pem
TRADE_WECHAT_API_V3_KEY=
TRADE_WECHAT_PLATFORM_PUBLIC_KEY_ID=
TRADE_WECHAT_PLATFORM_PUBLIC_KEY_PATH=/etc/low-altitude/secrets/wechat/pub_key.pem
# https://<LA_API_DOMAIN>/api/v1/trade/channels/wechat/notifications
TRADE_WECHAT_PAYMENT_NOTIFY_URL=
TRADE_WECHAT_REFUND_NOTIFY_URL=
